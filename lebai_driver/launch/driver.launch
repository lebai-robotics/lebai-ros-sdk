<launch>
  <arg name="robot_ip" default="127.0.0.1"/>
  <arg name="simulator" default="false"/>
  <arg name="namespace" default="lebai"/>
  <arg name="joint_names" default="[joint_1, joint_2, joint_3, joint_4, joint_5, joint_6]"/>
  <arg name="trajectory_action_name" default="/lebai_trajectory_controller"/>
  <arg name="gripper_action_name" default="/lebai_gripper_controller/gripper_cmd"/>
  <arg name="joint_state_publish_rate" default="20.0"/>
  <arg name="robot_state_publish_rate" default="10.0"/>
  <arg name="joint_motion_publish_rate" default="20.0"/>
  <arg name="io_state_publish_rate" default="10.0"/>
  <arg name="gripper_state_publish_rate" default="10.0"/>
  <arg name="gripper_joint_name" default="gripper_r_joint1"/>
  <arg name="io_state_device" default="robot"/>
  <arg name="io_state_digital_input_count" default="0"/>
  <arg name="io_state_digital_output_count" default="0"/>
  <arg name="io_state_analog_input_count" default="0"/>
  <arg name="io_state_analog_output_count" default="0"/>
  <arg name="io_state_dio_count" default="0"/>
  <arg name="publish_robot_description" default="true"/>
  <arg name="robot_model" default="lm3_with_gripper.xacro"/>

  <group ns="$(arg namespace)">
    <node pkg="lebai_driver" type="lebai_driver_node.py" name="lebai_driver" output="screen">
      <param name="robot_ip" type="str" value="$(arg robot_ip)"/>
      <param name="simulator" type="bool" value="$(arg simulator)"/>
      <param name="namespace" type="str" value="$(arg namespace)"/>
      <rosparam param="joint_names" subst_value="true">$(arg joint_names)</rosparam>
      <param name="trajectory_action_name" type="str" value="$(arg trajectory_action_name)"/>
      <param name="gripper_action_name" type="str" value="$(arg gripper_action_name)"/>
      <param name="joint_state_publish_rate" type="double" value="$(arg joint_state_publish_rate)"/>
      <param name="robot_state_publish_rate" type="double" value="$(arg robot_state_publish_rate)"/>
      <param name="joint_motion_publish_rate" type="double" value="$(arg joint_motion_publish_rate)"/>
      <param name="io_state_publish_rate" type="double" value="$(arg io_state_publish_rate)"/>
      <param name="gripper_state_publish_rate" type="double" value="$(arg gripper_state_publish_rate)"/>
      <param name="gripper_joint_name" type="str" value="$(arg gripper_joint_name)"/>
      <param name="io_state_device" type="str" value="$(arg io_state_device)"/>
      <param name="io_state_digital_input_count" type="int" value="$(arg io_state_digital_input_count)"/>
      <param name="io_state_digital_output_count" type="int" value="$(arg io_state_digital_output_count)"/>
      <param name="io_state_analog_input_count" type="int" value="$(arg io_state_analog_input_count)"/>
      <param name="io_state_analog_output_count" type="int" value="$(arg io_state_analog_output_count)"/>
      <param name="io_state_dio_count" type="int" value="$(arg io_state_dio_count)"/>
    </node>
    <group if="$(arg publish_robot_description)">
      <param name="robot_description"
             command="xacro '$(find lebai_lm3_support)/urdf/$(arg robot_model)'"/>
      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
        <remap from="joint_states" to="model/joint_states"/>
      </node>
    </group>
  </group>
</launch>
